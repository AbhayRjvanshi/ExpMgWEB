{
  "tag": "database:mysql",
  "display_name": "MySQL Database",
  "evidence_strategies": {
    "direct_usage": {
      "code_patterns": ["mysqli_", "new mysqli", "new PDO", "PDO::", "->prepare(", "->bind_param(", "->execute(", "->get_result(", "begin_transaction", "MYSQL_ATTR"],
      "string_patterns": ["mysql://", "pdo_mysql"],
      "file_extensions": [".php", ".py", ".sql"]
    },
    "architectural": {
      "exception_patterns": ["mysqli_error", "mysqli_sql_exception", "PDOException", "QueryException"]
    },
    "dependency": {
      "composer_packages": ["ext-mysqli", "ext-pdo_mysql", "doctrine/dbal", "doctrine/orm", "illuminate/database", "medoo/medoo"],
      "npm_packages": ["mysql", "mysql2", "sequelize", "knex", "typeorm"],
      "pip_packages": ["mysql-connector-python", "pymysql", "mysqlclient", "sqlalchemy"]
    },
    "configuration": {
      "env_key_patterns": ["DB_HOST", "DB_PORT", "DB_DATABASE", "DB_CONNECTION", "DB_USER", "MYSQL_"],
      "env_value_patterns": ["mysql", "mysqli", "3306"],
      "docker_service_names": ["mysql", "mariadb", "percona"]
    },
    "commit_keywords": ["mysql", "database", "query", "migration", "schema", "sql", "index", "transaction"]
  }
}
