{
  "tag": "caching:redis",
  "display_name": "Redis Cache / Store",
  "evidence_strategies": {
    "direct_usage": {
      "code_patterns": ["new Redis", "Redis::", "->setex(", "->lpush(", "->hset(", "RedisService", "predis", "phpredis"],
      "string_patterns": ["redis://"],
      "file_extensions": [".php", ".py", ".js"]
    },
    "architectural": {
      "exception_patterns": ["RedisException", "ConnectionException"]
    },
    "dependency": {
      "composer_packages": ["predis/predis", "ext-redis"],
      "npm_packages": ["redis", "ioredis"],
      "pip_packages": ["redis", "aioredis"]
    },
    "configuration": {
      "env_key_patterns": ["REDIS_", "CACHE_DRIVER", "SESSION_DRIVER", "NOTIFICATIONS_BACKEND"],
      "env_value_patterns": ["redis", "6379"],
      "docker_service_names": ["redis"]
    },
    "commit_keywords": ["redis", "cache", "caching", "ttl", "invalidate"]
  }
}
