{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DESIGN.md Extracted Structure",
  "type": "object",
  "required": [
    "metadata",
    "design_direction",
    "colors",
    "typography",
    "spacing",
    "layout",
    "components",
    "accessibility"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "name",
        "version",
        "author",
        "created_at"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      }
    },
    "design_direction": {
      "type": "object",
      "required": [
        "style",
        "target_audience",
        "summary"
      ],
      "properties": {
        "style": {
          "type": "string"
        },
        "target_audience": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "colors": {
      "type": "object",
      "required": [
        "primary",
        "secondary",
        "background",
        "text"
      ],
      "properties": {
        "primary": {
          "type": "string"
        },
        "secondary": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "typography": {
      "type": "object",
      "required": [
        "primary_font",
        "heading_scale",
        "body_size"
      ],
      "properties": {
        "primary_font": {
          "type": "string"
        },
        "heading_scale": {
          "type": "array"
        },
        "body_size": {
          "type": "string"
        }
      }
    },
    "spacing": {
      "type": "object",
      "required": [
        "spacing_scale"
      ],
      "properties": {
        "spacing_scale": {
          "type": "array"
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "grid_system",
        "breakpoints"
      ],
      "properties": {
        "grid_system": {
          "type": "string"
        },
        "breakpoints": {
          "type": "array"
        }
      }
    },
    "components": {
      "type": "object"
    },
    "accessibility": {
      "type": "object",
      "required": [
        "wcag_target",
        "contrast_strategy"
      ],
      "properties": {
        "wcag_target": {
          "type": "string"
        },
        "contrast_strategy": {
          "type": "string"
        }
      }
    }
  }
}