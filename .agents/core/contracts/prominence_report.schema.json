{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "prominence_report",
  "description": "JSON schema for the prominence scoring output file (prominence_report.json)",
  "type": "object",
  "required": [
    "scored_at",
    "thresholds_used",
    "skills",
    "mcps"
  ],
  "properties": {
    "scored_at": {
      "type": "string"
    },
    "thresholds_used": {
      "type": "object",
      "required": [
        "high_min",
        "moderate_min",
        "low_min"
      ],
      "properties": {
        "high_min": {
          "type": "integer"
        },
        "moderate_min": {
          "type": "integer"
        },
        "low_min": {
          "type": "integer"
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "prominence_score",
          "prominence_verdict",
          "verdict_statement",
          "confidence",
          "trend",
          "score_delta",
          "previous_score",
          "score_breakdown",
          "evidence_summary",
          "evidence_missing",
          "tags_unresolved",
          "scored_at"
        ],
        "properties": {
          "prominence_score": {
            "type": "number"
          },
          "prominence_verdict": {
            "type": "string",
            "enum": [
              "HIGH",
              "MODERATE",
              "LOW",
              "MINIMAL"
            ]
          },
          "verdict_statement": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "trend": {
            "type": "string",
            "enum": [
              "first_check",
              "rising",
              "declining",
              "stable"
            ]
          },
          "score_delta": {
            "type": [
              "number",
              "null"
            ]
          },
          "previous_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "score_breakdown": {
            "type": "object",
            "required": [
              "direct_usage",
              "architectural",
              "dependency",
              "configuration",
              "commit_history"
            ],
            "properties": {
              "direct_usage": {
                "type": "number"
              },
              "architectural": {
                "type": "number"
              },
              "dependency": {
                "type": "number"
              },
              "configuration": {
                "type": "number"
              },
              "commit_history": {
                "type": "number"
              }
            }
          },
          "evidence_summary": {
            "type": "string"
          },
          "evidence_missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags_unresolved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scored_at": {
            "type": "string"
          }
        }
      }
    },
    "mcps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "prominence_score",
          "prominence_verdict",
          "verdict_statement",
          "confidence",
          "trend",
          "score_delta",
          "previous_score",
          "score_breakdown",
          "evidence_summary",
          "evidence_missing",
          "tags_unresolved",
          "scored_at"
        ],
        "properties": {
          "prominence_score": {
            "type": "number"
          },
          "prominence_verdict": {
            "type": "string",
            "enum": [
              "HIGH",
              "MODERATE",
              "LOW",
              "MINIMAL"
            ]
          },
          "verdict_statement": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "trend": {
            "type": "string",
            "enum": [
              "first_check",
              "rising",
              "declining",
              "stable"
            ]
          },
          "score_delta": {
            "type": [
              "number",
              "null"
            ]
          },
          "previous_score": {
            "type": [
              "number",
              "null"
            ]
          },
          "score_breakdown": {
            "type": "object",
            "required": [
              "direct_usage",
              "architectural",
              "dependency",
              "configuration",
              "commit_history"
            ],
            "properties": {
              "direct_usage": {
                "type": "number"
              },
              "architectural": {
                "type": "number"
              },
              "dependency": {
                "type": "number"
              },
              "configuration": {
                "type": "number"
              },
              "commit_history": {
                "type": "number"
              }
            }
          },
          "evidence_summary": {
            "type": "string"
          },
          "evidence_missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags_unresolved": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scored_at": {
            "type": "string"
          }
        }
      }
    }
  }
}
