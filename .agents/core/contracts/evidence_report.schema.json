{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "evidence_report",
  "description": "JSON schema for the evidence collection output file (evidence_report.json)",
  "type": "object",
  "required": [
    "generated_at",
    "project_root",
    "files_scanned",
    "limits_used",
    "skills",
    "mcps"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp of evidence collection"
    },
    "project_root": {
      "type": "string",
      "description": "Absolute path of project root folder scanned"
    },
    "files_scanned": {
      "type": "integer",
      "minimum": 0
    },
    "limits_used": {
      "type": "object",
      "required": [
        "commit_history_days",
        "max_files_to_scan",
        "max_file_size_bytes"
      ],
      "properties": {
        "commit_history_days": {
          "type": "integer"
        },
        "max_files_to_scan": {
          "type": "integer"
        },
        "max_file_size_bytes": {
          "type": "integer"
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "discovery_evidence_tags",
          "tags_resolved",
          "tags_unresolved",
          "evidence",
          "evidence_missing"
        ],
        "properties": {
          "discovery_evidence_tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tags_resolved": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tags_unresolved": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "object"
          },
          "evidence_missing": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "mcps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "discovery_evidence_tags",
          "tags_resolved",
          "tags_unresolved",
          "evidence",
          "evidence_missing"
        ],
        "properties": {
          "discovery_evidence_tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tags_resolved": {
            "type": "array",
            "items": { "type": "string" }
          },
          "tags_unresolved": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence": {
            "type": "object"
          },
          "evidence_missing": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
