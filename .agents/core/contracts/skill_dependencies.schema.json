{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skill Dependency Graph",
  "type": "object",
  "required": [
    "skill_name",
    "dependencies"
  ],
  "properties": {
    "skill_name": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "minimum_version": {
            "type": "string"
          }
        }
      }
    }
  }
}