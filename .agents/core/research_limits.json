{
  "research_limits": {
    "max_rounds": 2,
    "max_total_urls": 25,
    "max_urls_per_category": 5,
    "max_findings_per_category": 10,
    "max_context_summary_words": 3000,
    "max_duplicate_similarity": 0.75,
    "max_research_time_minutes": 20
  },
  "workflow_rules": {
    "require_project_readme": true,
    "require_audience_confirmation_if_unclear": true,
    "allowed_modes": [
      "research",
      "design_md",
      "user_input"
    ],
    "require_mode_selection_before_research": true,
    "require_human_confirmation_before_final_design": true,
    "require_source_links_for_all_findings": true
  },
  "skill_discovery_rules": {
    "enabled": true,
    "discover_design_related_skills": true,
    "require_skill_source_link": true,
    "present_skill_installation_options": true,
    "allow_local_install": true,
    "allow_global_install": true,
    "require_user_choice_for_install_location": true,
    "require_user_choice_for_skill_selection": true,
    "explain_install_pros_cons": true
  },
  "design_md_rules": {
    "enabled": true,
    "allow_design_md_search": true,
    "present_links_only_on_first_pass": true,
    "allow_fetch_after_user_selection": true,
    "allow_one_extra_search_round": true,
    "require_user_selection_before_installing": true,
    "require_design_md_path_tracking": true
  },
  "research_categories": {
    "design_principles": {
      "enabled": true,
      "priority": "high",
      "max_urls": 5,
      "description": "Research official design systems, UX principles, accessibility standards, typography systems, and visual hierarchy guidance."
    },
    "competitor_analysis": {
      "enabled": true,
      "priority": "high",
      "max_urls": 5,
      "description": "Research websites or apps serving similar purposes and audiences to study layout patterns, navigation structures, workflows, and interaction styles."
    },
    "design_showcases": {
      "enabled": true,
      "priority": "medium",
      "max_urls": 5,
      "description": "Research showcase platforms such as Dribbble, Behance, Mobbin, and Awwwards for inspiration and modern UI patterns."
    },
    "template_libraries": {
      "enabled": true,
      "priority": "medium",
      "max_urls": 5,
      "description": "Research free and open design template ecosystems to identify reusable structures and common component conventions."
    },
    "audience_research": {
      "enabled": true,
      "priority": "high",
      "max_urls": 5,
      "description": "Research user psychology, accessibility expectations, demographic preferences, and usability behaviors of the target audience."
    }
  },
  "source_quality_rules": {
    "preferred_sources": [
      "official design systems",
      "accessibility documentation",
      "enterprise SaaS products",
      "production-grade applications",
      "trusted UX research blogs",
      "government accessibility resources",
      "real-world high-traffic products"
    ],
    "low_priority_sources": [
      "trend-heavy showcase concepts",
      "visual-only inspiration boards",
      "unverified AI-generated templates",
      "experimental portfolio designs"
    ],
    "blocked_sources": [
      "stolen template repositories",
      "malware or ad-heavy websites",
      "fake clone galleries",
      "non-functional concept dumps"
    ],
    "source_weighting": {
      "preferred": 1.0,
      "low_priority": 0.4,
      "blocked": 0.0
    },
    "must_record_source_url": true,
    "must_record_source_type": true,
    "must_record_credibility_score": true,
    "must_record_reason_for_selection": true,
    "minimum_allowed_credibility_score": 4.0,
    "prefer_real_world_products_over_concepts": true,
    "prefer_accessible_design_sources": true,
    "prefer_production_ready_patterns": true,
    "allow_low_priority_sources_as_secondary_inspiration": true,
    "ignore_blocked_sources_completely": true,
    "anti_copycat_detection": {
      "enabled": true,
      "detect_repeated_template_patterns": true,
      "detect_mass-cloned_ui_patterns": true,
      "penalize_low_originality_sources": true,
      "copycat_penalty_score": 0.35
    },
    "trend_vs_usability_balancing": {
      "enabled": true,
      "prefer_usability_over_visual_trends": true,
      "penalize_visual_only_patterns": true,
      "penalize_inaccessible_trend_patterns": true,
      "maximum_trend_influence": 0.45
    },
    "accessibility_filtering": {
      "enabled": true,
      "reject_low_contrast_patterns": true,
      "reject_visual_hierarchy_failures": true,
      "reject_mobile_unfriendly_patterns": true,
      "prefer_wcag_aligned_sources": true
    },
    "template_quality_filtering": {
      "enabled": true,
      "reject_template_spam_sites": true,
      "reject_low_quality_component_dumps": true,
      "prefer_structured_design_systems": true
    }
  },
  "deduplication_rules": {
    "enabled": true,
    "similarity_threshold": 0.75,
    "group_similar_patterns": true,
    "compress_recurring_findings": true,
    "max_duplicate_groups": 15,
    "avoid_revisiting_same_domain_on_rerun": true,
    "prefer_new_domains_on_rerun": true,
    "merge_same_pattern_across_sources": true
  },
  "research_saturation_rules": {
    "enabled": true,
    "stop_conditions": {
      "duplicate_ratio_above": 0.6,
      "new_pattern_rate_below": 0.2,
      "remaining_url_budget_below": 1,
      "context_summary_limit_reached": true,
      "research_time_limit_reached": true
    },
    "warn_when": {
      "duplicate_ratio_above": 0.45,
      "new_pattern_rate_below": 0.3
    },
    "saturation_behavior": {
      "halt_research_when_saturated": true,
      "require_human_review_after_saturation": true,
      "allow_manual_override": true,
      "generate_saturation_report": true
    },
    "require_human_review_before_second_rerun": true
  },
  "session_tracking": {
    "track_visited_urls": true,
    "track_visited_domains": true,
    "track_findings": true,
    "track_duplicate_patterns": true,
    "track_token_estimates": true,
    "track_research_rounds": true
  },
  "human_interaction_rules": {
    "require_explicit_confirmation_before_finalizing": true,
    "allow_research_rerun": true,
    "max_reruns": 1,
    "allow_user_provided_references": true,
    "allow_user_direct_design_input": true,
    "require_design_discussion_before_output": true,
    "require_user_choice_for_path": true,
    "require_user_choice_for_skill_installation": true,
    "require_user_choice_for_install_location": true,
    "require_user_final_signoff_before_design_tokens": true
  },
  "output_rules": {
    "require_source_links": true,
    "require_reasoning_for_findings": true,
    "require_pattern_grouping": true,
    "require_design_spec_summary": true,
    "require_traceable_design_tokens": true,
    "require_path_used_field": true,
    "require_installed_skills_field": true,
    "require_source_references_field": true
  },
  "design_evaluation_rules": {
    "enabled": true,
    "weighted_scoring": true,
    "generate_rankings": true,
    "detect_design_conflicts": true,
    "detect_accessibility_risks": true,
    "detect_scalability_risks": true,
    "detect_mobile_adaptation_risks": true,
    "evaluation_categories": {
      "accessibility": {
        "enabled": true,
        "weight": 1.0
      },
      "readability": {
        "enabled": true,
        "weight": 0.9
      },
      "mobile_adaptability": {
        "enabled": true,
        "weight": 0.9
      },
      "audience_fit": {
        "enabled": true,
        "weight": 1.0
      },
      "implementation_complexity": {
        "enabled": true,
        "weight": 0.7
      },
      "design_consistency": {
        "enabled": true,
        "weight": 0.9
      },
      "scalability": {
        "enabled": true,
        "weight": 0.8
      }
    },
    "minimum_allowed_design_score": 6.5,
    "require_human_review_for_low_scores": true
  },
  "safety_rules": {
    "never_hallucinate_sources": true,
    "never_generate_untraceable_design_tokens": true,
    "never_ignore_research_limits": true,
    "never_repeat_same_urls_in_reruns": true,
    "never_finalize_without_human_confirmation": true,
    "never_install_skills_without_human_approval": true,
    "never_fetch_design_md_without_user_selection": true,
    "never_install_from_design_md_without_user_selection": true
  },
  "mcp_search_budget": {
    "max_total_registry_urls": 10,
    "max_results_per_category": 3,
    "max_categories_to_search": 8,
    "use_fallback_on_empty_category": true,
    "deduplication": {
      "enabled": true,
      "keep_official_over_community": true
    },
    "scoring": {
      "official_registry_score": 1.0,
      "community_registry_score": 0.7
    }
  }
}