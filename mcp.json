{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "C:/xampp/htdocs/ExpMgWEB"],
      "description": "Full read/write access to the project tree"
    },
    "git": {
      "command": "uvx",
      "args": ["mcp-server-git", "--repository", "C:/xampp/htdocs/ExpMgWEB"],
      "description": "Git blame, diff, log across all versions"
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"],
      "description": "Fetch live PHP 8 / Chart.js / jsPDF / Redis docs"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "description": "Step-by-step reasoning for settlement logic and race conditions"
    },
    "mysql": {
      "command": "npx",
      "args": ["-y", "@benborla29/mcp-server-mysql"],
      "env": {
        "MYSQL_HOST": "127.0.0.1",
        "MYSQL_PORT": "3306",
        "MYSQL_USER": "root",
        "MYSQL_PASS": "",
        "MYSQL_DB": "ExpMgWEB",
        "ALLOW_INSERT_OPERATION": "false",
        "ALLOW_UPDATE_OPERATION": "false",
        "ALLOW_DELETE_OPERATION": "false"
      },
      "description": "Read-only live DB access — all 13 tables"
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "description": "Version-accurate library docs on demand"
    },
    "redis": {
      "command": "npx",
      "args": ["-y", "mcp-redis"],
      "env": {
        "REDIS_HOST": "127.0.0.1",
        "REDIS_PORT": "6379"
      },
      "description": "Inspect Redis keys when NOTIFICATIONS_BACKEND=redis — disable if Redis not running"
    }
  }
}
