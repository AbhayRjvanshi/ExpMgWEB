# ============================================================
# PHASE 3.1 — PROOF OF CONCEPT ENVIRONMENT CONFIGURATION
# ============================================================
# Dedicated isolated Supabase development project for Phase 3.1 feasibility.
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
#
# INSTRUCTIONS:
# 1. Copy this file to .env.phase3_1:
#      cp .env.phase3_1.example .env.phase3_1
# 2. Populate with your Supabase development project values.
# 3. .env.phase3_1 is automatically ignored by Git.

# --- Supabase Project Identifiers & API Keys ---
# NOTE: Supabase is deprecating legacy 'anon' and 'service_role' keys by end of 2026.
# Use the modern Publishable Key for client and ordinary Auth operations.
# (No test in Phase 3.1 requires elevated administrative API privileges / Secret Key).
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# --- Administrative Database Credentials (Controlled Setup & DDL) ---
# Used strictly for administrative setup, schema migrations, table creation,
# and granting privileges to the application runtime role.
# Connects directly via Port 5432 to the primary database instance.
# (Not used by application runtime code).
SUPABASE_ADMIN_DB_USER=postgres
SUPABASE_ADMIN_DB_PASSWORD=YOUR_ADMIN_DATABASE_PASSWORD_HERE

# ============================================================
# DATABASE CONNECTION MODES (Runtime Role: expmg_app)
# ============================================================

# Mode A: Direct PostgreSQL Connection (Port 5432)
# Direct connection to the Postgres instance for persistent backends.
# Reachable over IPv6 (or IPv4 if the IPv4 add-on is enabled).
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=expmg_app
SUPABASE_DB_PASSWORD=YOUR_EXPMG_APP_PASSWORD_HERE

# Modes B & C: Shared Supavisor Pooler (IPv4-compatible)
# CRITICAL: Retrieve the exact pooler host string directly from your Supabase Dashboard:
#   Project Settings -> Database -> Connection Pooling -> Host
# Do NOT guess cluster indices (e.g. aws-0, aws-1 vary by region & assignment).
# Pooler username format: expmg_app.<project-ref>
SUPABASE_POOLER_HOST=your-exact-pooler-host-from-dashboard.pooler.supabase.com
SUPABASE_POOLER_USER=expmg_app.your-project-ref
SUPABASE_POOLER_PASSWORD=YOUR_EXPMG_APP_PASSWORD_HERE

# Mode B: Shared Session Pooler (Port 5432)
# Preserves persistent backend connection for long-lived sessions on IPv4 networks.
# Supports server-side prepared statements.
SUPABASE_POOLER_PORT_SESSION=5432

# Mode C: Shared Transaction Pooler (Port 6543)
# Recommended for stateless PHP requests. Multiplexes queries across pooled connections.
# Requires PDO::ATTR_EMULATE_PREPARES => true (server-side prepared statements unsupported).
SUPABASE_POOLER_PORT_TRANSACTION=6543

# --- Disposable Test Account (For Auth & Token Lifecycle Tests) ---
# Provide a valid email address controlled by the owner/tester.
# If "Confirm email" is enabled in Supabase Auth project settings, you must
# have access to this inbox to confirm the account, or confirm it via SQL/dashboard.
TEST_USER_EMAIL=your-controlled-test-email@domain.com
TEST_USER_PASSWORD=YOUR_SECURE_TEST_PASSWORD_HERE
