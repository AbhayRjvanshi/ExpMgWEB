# ============================================================
# EXPENSE MANAGER - ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================
# This file (.env.example) is a TEMPLATE showing what variables
# are required to run the application.
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual credentials
# 3. .env is automatically gitignored (never committed)
# 4. .env.example stays in git as documentation
#
# SECURITY NOTE:
# - .env.example contains NO real secrets (all values are defaults)
# - .env contains YOUR actual credentials (keep it private)
# - .gitignore prevents .env from being committed to git
# ============================================================

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# H1 (PENTEST/highly sever/H1.md): the application connects through a
# least-privilege account -- NOT root. The account holds exactly
# SELECT, INSERT, UPDATE, DELETE on ExpMgWEB.* plus DROP on
# ExpMgWEB.rate_limits (needed by the test suite's TRUNCATE calls).
# DDL (CREATE/ALTER/DROP of schema objects) is performed by a DBA
# account via schema.sql / migration files, never by the app.
#
# One-time bootstrap (run as a DBA account, e.g. root):
#   CREATE USER 'expmg_app'@'localhost' IDENTIFIED BY '<generated>';
#   CREATE USER 'expmg_app'@'127.0.0.1' IDENTIFIED BY '<generated>';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ExpMgWEB.* TO 'expmg_app'@'localhost';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ExpMgWEB.* TO 'expmg_app'@'127.0.0.1';
#   GRANT DROP ON ExpMgWEB.rate_limits TO 'expmg_app'@'localhost';
#   GRANT DROP ON ExpMgWEB.rate_limits TO 'expmg_app'@'127.0.0.1';
#
DB_HOST=127.0.0.1          # MySQL server address (localhost for XAMPP)
DB_PORT=3306               # MySQL port (default: 3306)
DB_USER=expmg_app          # least-privilege application account (never root)
DB_PASS=change-me          # the expmg_app password set during bootstrap
DB_NAME=ExpMgWEB           # Database name

# ============================================================
# APPLICATION ENVIRONMENT
# ============================================================
APP_ENV=development        # Environment: development, staging, production
APP_DEBUG=0                # Debug mode: 1 (on) or 0 (off)

# ============================================================
# NOTIFICATIONS CONFIGURATION
# ============================================================
# Backend: file (default) or redis
# Use 'file' for standard XAMPP/LAMP setups
# Use 'redis' for high-volume deployments (requires Redis server)
NOTIFICATIONS_BACKEND=file

# Redis connection (only used when NOTIFICATIONS_BACKEND=redis)
REDIS_HOST=127.0.0.1       # Redis server address
REDIS_PORT=6379            # Redis port (default: 6379)
# REDIS_PASSWORD=          # Redis password (if required)

